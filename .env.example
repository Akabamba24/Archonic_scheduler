PORT=8787
CLIENT_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
DATA_DIR=server/data
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Required only when Confirmation delivery mode is set to Live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional. If omitted, the AI classifier uses demo rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
